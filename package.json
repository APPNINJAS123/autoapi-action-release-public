{
  "name": "automated-api-and-data",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "test": "pnpm build && pnpm -r --workspace-concurrency=1 --if-present test && pnpm test:scripts",
    "test:scripts": "vitest run scripts/tests --maxWorkers=2 --minWorkers=1",
    "test:coverage": "pnpm build && pnpm -r --workspace-concurrency=1 --if-present test:coverage",
    "test:package-managers": "pnpm build && node scripts/test-package-manager-containers.mjs",
    "test:python-action-e2e": "pnpm build && node scripts/test-python-action-e2e.mjs",
    "test:python-certified-full-repo": "node scripts/test-python-certified-full-repo.mjs",
    "test:javascript-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs javascript",
    "test:typescript-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs typescript",
    "test:rust-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs rust",
    "test:go-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs go",
    "test:c-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs c",
    "test:cpp-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs cpp",
    "test:java-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs java",
    "test:kotlin-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs kotlin",
    "test:scala-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs scala",
    "test:csharp-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs csharp",
    "test:php-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs php",
    "test:ruby-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs ruby",
    "test:swift-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs swift",
    "test:dart-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs dart",
    "test:elixir-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs elixir",
    "test:clojure-action-e2e": "pnpm build && node scripts/test-native-action-e2e.mjs clojure",
    "test:provider-recipes": "pnpm build && node scripts/test-provider-recipe-containers.mjs",
    "test:expanded-provider-packages": "node scripts/test-expanded-provider-packages.mjs",
    "test:provider-package-coverage": "pnpm build && node scripts/test-provider-package-coverage.mjs",
    "test:provider-package-registry": "pnpm build && node scripts/test-provider-package-registry.mjs",
    "evidence:capture-providers": "pnpm build && node scripts/capture-provider-history-evidence.mjs",
    "test:provider-history-evidence": "pnpm build && node scripts/test-provider-history-evidence.mjs",
    "audit:provider-history-evidence": "pnpm build && node scripts/test-provider-history-evidence.mjs all",
    "audit:native-history": "pnpm build && node scripts/audit-official-native-history.mjs",
    "audit:cpp-history": "pnpm build && node scripts/audit-cpp-history.mjs",
    "audit:c-history": "pnpm build && node scripts/audit-c-history.mjs",
    "audit:managed-language-history": "pnpm build && node scripts/audit-managed-language-history.mjs",
    "capture:package-history-activation": "pnpm build && OFFICIAL_PACKAGE_AUDIT_CHECKPOINT=../../.data/package-history-activation.ndjson OFFICIAL_PACKAGE_AUDIT_OUTPUT=../../fixtures/package-history-activation.json pnpm --filter @automated-api/part-a audit:packages:official",
    "test:package-history-activation": "pnpm build && node scripts/test-package-history-activation.mjs",
    "test:managed-package-history-activation": "pnpm build && node scripts/test-managed-package-history-activation.mjs",
    "capture:managed-package-history-activation": "pnpm build && node scripts/capture-managed-package-history-activation.mjs",
    "test:old-sdk-lab": "pnpm build && node scripts/test-old-sdk-lab.mjs",
    "audit:provider-lab": "pnpm build && node scripts/audit-provider-lab.mjs",
    "audit:real-repository": "pnpm build && node scripts/audit-real-repository.mjs",
    "audit:language-real-repository-route": "pnpm build && node scripts/audit-language-real-repository-route.mjs",
    "audit:clojure-real-repo": "pnpm build && node scripts/audit-clojure-real-repository.mjs",
    "audit:cpp-real-repository": "pnpm build && node scripts/audit-cpp-real-repository.mjs",
    "audit:c-real-repository": "pnpm build && node scripts/audit-c-real-repository.mjs",
    "test:provider-lab-routing": "node scripts/test-provider-lab-routing.mjs",
    "test:live-openrouter-provider-lab": "node scripts/test-live-openrouter-provider-lab.mjs",
    "test:live-openrouter-real-repo": "node scripts/test-live-openrouter-real-repo.mjs",
    "test:live-language-real-repo": "node scripts/test-live-language-real-repo.mjs",
    "test:live-official-real-repo": "node scripts/test-live-official-real-repo.mjs",
    "test:live-multi-pr-real-repo": "node scripts/test-live-multi-pr-real-repo.mjs",
    "acceptance:production": "pnpm build && pnpm --filter @automated-api/github-app acceptance:production",
    "demo:person-b": "pnpm build && pnpm --filter @automated-api/github-app exec vitest run tests/e2e.test.ts",
    "workflow:render": "node scripts/render-customer-workflow.mjs",
    "action:export": "node scripts/export-action-release.mjs",
    "evidence:index-pr17-final": "node scripts/build-pr17-final-acceptance-index.mjs",
    "evidence:body-pr17-final": "node scripts/build-pr17-final-pr-body.mjs",
    "campaign:pr17-final": "node scripts/control-pr17-final-campaign.mjs"
  },
  "dependencies": {
    "@deepseek-ai/dsh-sdk-client": "0.1.0-rc.7"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@vitest/coverage-v8": "3.2.6",
    "pnpm": "11.19.0",
    "typescript": "5.7.3",
    "vitest": "3.2.6"
  }
}
